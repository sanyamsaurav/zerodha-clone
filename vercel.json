{
    "version": 2,
    "builds": [
        {
            "src": "backend/api/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "dashboard/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/api/index.js"
        },
        {
            "src": "/dashboard",
            "dest": "dashboard/package.json"
        },
        {
            "src": "/dashboard/(.*)",
            "dest": "dashboard/package.json"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/package.json"
        }
    ]
}